# 复制为 .env 后按需修改。所有变量都可选；不填任何密钥也能离线跑通整条流程。
# 生成用的 Liblib / 文本模型 / 配音密钥推荐在页面「模型设置」里按账号填写，不必写在这里。

# ---------- 服务 ----------
# COMIC_HOST=127.0.0.1
# COMIC_PORT=8001
# COMIC_DATA_DIR=.runtime

# ---------- 公网部署 ----------
# 经反向代理对外提供服务时必须打开：每个访客都要登录自己的账号。
# COMIC_REQUIRE_LOGIN=true
# COMIC_ALLOWED_HOSTS='["drama.example.com"]'
# 视频生成需要：Liblib 通过这个 https 地址拉取首帧图片。
# COMIC_DRAMA_PUBLIC_BASE_URL=https://drama.example.com
# 可以给账号加积分、处理待复核任务的管理员（账号 ID）。
# COMIC_CREDIT_ADMINS='["admin_user"]'

# ---------- 运营 ----------
# 每个账号每天最多消耗的积分（0 = 不限）
# COMIC_DRAMA_DAILY_CAP=500
# 每个账号的素材空间上限（MB，0 = 不限）
# COMIC_DRAMA_MEDIA_QUOTA_MB=0
# 生成素材保留天数（0 = 永久保留）
# COMIC_DRAMA_MEDIA_RETENTION_DAYS=0
# 成片字幕：soft（字幕轨）| burn（烧录进画面）
# COMIC_DRAMA_SUBTITLE_MODE=soft
# 成片分辨率：source | 720p | 1080p
# COMIC_DRAMA_OUTPUT_RESOLUTION=source
# AI 生成内容标识
# COMIC_DRAMA_AI_LABEL=AI 生成
# COMIC_DRAMA_AI_DISCLOSURE=
# 内容审核追加敏感词（逗号分隔）
# COMIC_DRAMA_AUDIT_BLOCKLIST=
# 充值回调的签名密钥
# COMIC_DRAMA_PAYMENT_SECRET=

# ---------- 部署方统一密钥（可选） ----------
# 设为 remote 后，未在页面填写密钥的账号也使用下面这组部署方密钥。
# COMIC_DRAMA_PROVIDER=remote
# COMIC_DRAMA_LLM_BASE_URL=https://api.deepseek.com/v1
# COMIC_DRAMA_LLM_MODEL=deepseek-chat
# DRAMA_LLM_API_KEY=
# COMIC_DRAMA_T2I_CHANNEL=official
# COMIC_DRAMA_I2V_CHANNEL=official
# LIBTV_ACCESS_KEY=
# LIBTV_SECRET_KEY=
# FFmpeg 可执行文件
# COMIC_DRAMA_FFMPEG=ffmpeg
